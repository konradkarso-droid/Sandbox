<?xml version="1.0" encoding="utf-8"?>
<!-- Малый стенд шага 9б. Разрешений нет: ни сети, ни чужих файлов. Модель
     владелец даёт системным окном выбора файла. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ru.prostranstvo.stend9"
    android:versionCode="1"
    android:versionName="1.0 (малый стенд 9б)">

    <application
        android:label="Малый стенд 9б"
        android:allowBackup="false"
        android:extractNativeLibs="true">
        <service android:name="stend.android.ModelService" android:isolatedProcess="true"
            android:exported="false" />
        <activity
            android:name="stend.android.MainActivity9"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
